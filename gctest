#!/bin/sh
# gctest -- compile and run OCaml code against the verified GC.
#
#   ./gctest prog.ml              bytecode and native
#   ./gctest --byte prog.ml       one mode only
#   ./gctest --native prog.ml
#   ./gctest tests/dir            every t*.ml in a directory; if the directory
#                                 has expected_output.txt, diff against it
#   ./gctest --rebuild            rebuild the GC + runtime and stop
#   ./gctest --check              report which collector is linked and stop
#
# Rebuilds automatically when the snapshot or the bridge is newer than the built
# archives, so the two ways of silently testing the wrong collector -- a stale
# stdlib/ copy, or a runtime that predates your edit -- cannot happen here.
set -u

ROOT=$(cd "$(dirname "$0")" && pwd)
GC=$ROOT/generational/ocaml-integration/ocaml-4.14-verified-gen
VG=$ROOT/generational/ocaml-integration/verified_gc
SNAP=$ROOT/generational/snapshot/GC_Gen_Impl.c

MODE=both
ACTION=run
REBUILD=auto
TARGET=

while [ $# -gt 0 ]; do
  case $1 in
    --byte|--bytecode) MODE=byte ;;
    --native)          MODE=native ;;
    --rebuild)         ACTION=rebuild ;;
    --check)           ACTION=check ;;
    --no-rebuild)      REBUILD=no ;;
    -h|--help)         awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    -*)                echo "gctest: unknown option $1" >&2; exit 2 ;;
    *)                 TARGET=$1 ;;
  esac
  shift
done

newer() { [ "$1" -nt "$2" ]; }

stale() {
  [ -f "$GC/runtime/ocamlrun" ]     || return 0
  [ -f "$GC/runtime/libasmrun.a" ]  || return 0
  [ -f "$GC/stdlib/libasmrun.a" ]   || return 0
  cmp -s "$GC/runtime/libasmrun.a" "$GC/stdlib/libasmrun.a" || return 0
  cmp -s "$GC/runtime/libcamlrun.a" "$GC/stdlib/libcamlrun.a" || return 0
  newer "$SNAP" "$VG/GC_Gen_Impl.o"            && return 0
  newer "$VG/alloc_gen.c" "$VG/alloc_gen.o"    && return 0
  newer "$VG/GC_Gen_Impl.o" "$GC/runtime/libcamlrun.a" && return 0
  newer "$VG/GC_Gen_Impl.n.o" "$GC/runtime/libasmrun.a" && return 0
  return 1
}

rebuild() {
  echo "gctest: rebuilding the verified GC and both runtimes..."
  make -C "$VG" >/dev/null 2>&1 || { echo "gctest: verified_gc build failed" >&2; exit 1; }
  ( cd "$GC" && make runtime runtimeopt ) >/dev/null 2>&1 \
    || { echo "gctest: runtime build failed; try it by hand:" >&2
         echo "  make -C $VG && (cd $GC && make runtime runtimeopt)" >&2; exit 1; }
  echo "gctest: rebuilt."
}

report_check() {
  echo "snapshot   $(md5sum "$SNAP" | cut -c1-12)  $SNAP"
  echo "libcamlrun $(md5sum "$GC/runtime/libcamlrun.a" | cut -c1-12)  (bytecode)"
  echo "libasmrun  $(md5sum "$GC/runtime/libasmrun.a"  | cut -c1-12)  (native)"
  if cmp -s "$GC/runtime/libasmrun.a" "$GC/stdlib/libasmrun.a"; then
    echo "stdlib copy in sync"
  else
    echo "stdlib copy STALE -- native would link the wrong collector"
  fi
  n=$(ar t "$GC/runtime/libasmrun.a" 2>/dev/null | grep -c 'GC_Gen_Impl\|alloc_gen')
  echo "verified objects inside libasmrun.a: $n (expect 2+)"
}

[ "$ACTION" = rebuild ] && { rebuild; report_check; exit 0; }
# --check reports, never repairs: it is for diagnosing a state, so rebuilding
# first would hide exactly what you asked about.
[ "$ACTION" = check ] && { report_check; stale && echo "STALE -- run ./gctest --rebuild"; exit 0; }
if [ "$REBUILD" = auto ] && stale; then rebuild; fi

[ -n "$TARGET" ] || { echo "gctest: nothing to run (try --help)" >&2; exit 2; }

WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
BYTEC="$GC/ocamlc.opt   -nostdlib -I $GC/stdlib -use-runtime $GC/runtime/ocamlrun"
NATC="$GC/ocamlopt.opt  -nostdlib -I $GC/runtime -I $GC/stdlib"

pass=0; fail=0

# $1 source file, $2 expected-output file or empty
run_file() {
  src=$1; exp=$2
  base=$(basename "$src" .ml)
  cp "$src" "$WORK/$base.ml"
  for m in byte native; do
    [ "$MODE" = both ] || [ "$MODE" = "$m" ] || continue
    ( cd "$WORK" || exit 1
      if [ "$m" = byte ]; then $BYTEC -o "$base.byte" "$base.ml"; else $NATC -o "$base.exe" "$base.ml"; fi
    ) 2>"$WORK/$base.$m.cerr"
    if [ $? -ne 0 ]; then
      printf '%-26s %-8s COMPILE FAIL\n' "$base" "$m"
      sed 's/^/    /' "$WORK/$base.$m.cerr" | head -5
      fail=$((fail+1)); continue
    fi
    [ "$m" = byte ] && exe="$WORK/$base.byte" || exe="$WORK/$base.exe"
    "$exe" > "$WORK/$base.$m.out" 2>"$WORK/$base.$m.err"; rc=$?
    if [ $rc -ne 0 ]; then
      printf '%-26s %-8s FAIL (exit %d%s)\n' "$base" "$m" "$rc" \
        "$([ $rc -ge 128 ] && echo ", signal $((rc-128))")"
      sed 's/^/    /' "$WORK/$base.$m.err" | head -5
      fail=$((fail+1)); continue
    fi
    if [ -n "$exp" ]; then
      if awk -v t="=== $base" '$0==t{f=1;next} /^=== /{f=0} f' "$exp" \
           | diff -q - "$WORK/$base.$m.out" >/dev/null 2>&1; then
        printf '%-26s %-8s ok\n' "$base" "$m"; pass=$((pass+1))
      else
        printf '%-26s %-8s OUTPUT DIFFERS\n' "$base" "$m"
        printf '    expected: %s\n' "$(awk -v t="=== $base" '$0==t{f=1;next} /^=== /{f=0} f' "$exp" | tr '\n' ' ')"
        printf '    got:      %s\n' "$(tr '\n' ' ' < "$WORK/$base.$m.out")"
        fail=$((fail+1))
      fi
    else
      printf '%-26s %-8s ok\n' "$base" "$m"; pass=$((pass+1))
      sed 's/^/    /' "$WORK/$base.$m.out"
    fi
  done
}

if [ -d "$TARGET" ]; then
  exp=""; [ -f "$TARGET/expected_output.txt" ] && exp="$(cd "$TARGET" && pwd)/expected_output.txt"
  found=no
  for f in "$TARGET"/t*.ml; do
    [ -e "$f" ] || continue
    found=yes; run_file "$f" "$exp"
  done
  [ "$found" = yes ] || { echo "gctest: no t*.ml in $TARGET" >&2; exit 2; }
  echo; echo "passed $pass, failed $fail"
  [ "$fail" -eq 0 ]
else
  [ -f "$TARGET" ] || { echo "gctest: no such file: $TARGET" >&2; exit 2; }
  run_file "$TARGET" ""
  [ "$fail" -eq 0 ]
fi
